# Matrix homeserver
HOMESERVER_URL=https://matrix.example.org
HOMESERVER_DOMAIN=example.org

# Bot credentials
BOT_USERNAME=mybot
BOT_PASSWORD=
BOT_DISPLAY_NAME=My Bot

# SSH to Matrix server (for register_bot.py)
SSH_HOST=
SSH_USER=root
SSH_PORT=22
SSH_PASSWORD=
SSH_KEY=

# Docker container name for Synapse (from docker-compose.yml)
SYNAPSE_CONTAINER=synapse

# Path to matrix data on server (where docker-compose.yml lives)
MATRIX_REMOTE_DIR=/root/matrix

# Shared secret from homeserver.yaml (only needed for register_bot.py)
REGISTRATION_SHARED_SECRET=
